# Server-side secrets for the portfolio stack. On the server: ~/apps/portfolio/.env (chmod 600).
# Never commit the real .env.

# Contact API → Gmail SMTP (use a Google "App password", not your account password)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Security=StartTls
Smtp__User=you@gmail.com
Smtp__Password=
# Where contact messages are delivered
Smtp__To=you@gmail.com
